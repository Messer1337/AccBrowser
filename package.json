{
  "name": "oasis-browser",
  "version": "1.0.0",
  "description": "OASIS Browser - Multi-Account Isolated Profile Platform",
  "author": "OASIS Team",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac --win",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "release": "electron-builder --mac --win --publish always && node scripts/prepare-hosting.js && firebase deploy --only hosting"
  },
  "build": {
    "appId": "com.oasisbrowser.app",
    "productName": "OASIS Browser",
    "icon": "assets/icon.png",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "generic",
      "url": "https://accbrowser.web.app/updates/"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "fingerprint-generator": "^2.1.58",
    "fingerprint-injector": "^2.1.58",
    "firebase": "^10.12.0",
    "fs-extra": "^11.2.0",
    "puppeteer-core": "^22.10.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  }
}
