{
  "name": "oasis-browser",
  "version": "1.6.1",
  "description": "OASIS Browser - Multi-Account Isolated Profile Platform",
  "author": "OASIS Team",
  "main": "src/main/index.js",
  "scripts": {
    "clean": "rm -rf dist hosting_updates",
    "prebuild": "npm run clean",
    "prerelease": "npm run clean",
    "start": "electron .",
    "build": "electron-builder --mac --win",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "release": "node scripts/extract-release-notes.js && GH_TOKEN=$(gh auth token 2>/dev/null || echo $GH_TOKEN) electron-builder --mac --win --publish always"
  },
  "build": {
    "appId": "com.oasisbrowser.app",
    "productName": "OASIS Browser",
    "icon": "assets/icon.png",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "Messer1337",
      "repo": "AccBrowser",
      "private": false,
      "releaseType": "release"
    },
    "releaseInfo": {
      "releaseNotesFile": "RELEASE_NOTES_CURRENT.md"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "CHANGELOG.md"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "fingerprint-generator": "^2.1.58",
    "fingerprint-injector": "^2.1.58",
    "firebase": "^10.12.0",
    "fs-extra": "^11.2.0",
    "https-proxy-agent": "^9.1.0",
    "puppeteer-core": "^22.10.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "socks-proxy-agent": "^10.1.0"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  }
}
