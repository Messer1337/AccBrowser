# Postgres connection string used by both the API and node-pg-migrate.
DATABASE_URL=postgres://oasis:changeme@postgres:5432/oasis

# HMAC secret for signing session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# Port the Express + Socket.IO server listens on inside the container.
PORT=3000

# One-time bootstrap admin, created only if this username does not already exist.
# Leave ADMIN_PASSWORD unset after the first successful run.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
