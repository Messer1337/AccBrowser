# Used by docker-compose.yml to stand up the self-hosted AccBrowser backend.
# Copy to .env, fill in real values, then: docker compose up -d

POSTGRES_DB=oasis
POSTGRES_USER=oasis
POSTGRES_PASSWORD=change-me

# openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# One-time bootstrap admin. Leave ADMIN_PASSWORD blank after the first successful run.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Your real domain (Caddy will provision a Let's Encrypt certificate for it).
# Leave unset / "localhost" for local testing without TLS.
OASIS_DOMAIN=
