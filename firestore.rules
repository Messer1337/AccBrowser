rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A user is "authorized" only if an admin has manually added their uid here
    // via the Firebase Console (see authorizedUsers rules below for why this can't
    // be self-service in a backend-less client app).
    function isAuthorized() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid));
    }

    function myRole() {
      return get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthorized() && myRole() == 'admin';
    }

    function hasProfileAccess(profileId) {
      return isAdmin() || (
        isAuthorized()
        && get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.keys().hasAll(['allowedProfiles'])
        && get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.allowedProfiles.hasAny([profileId, '*'])
      );
    }

    function isValidProfile(profileId) {
      let profile = request.resource.data;
      return profile.keys().hasOnly([
          'id', 'name', 'url', 'proxy', 'userAgent', 'timezone', 'cookies', 'fingerprint', 'fingerprintHeaders', 'fingerprintUpdatedAt', 'revision', 'updatedBy',
          'activeHolder', 'updatedAt', 'lastSyncUser', 'lastSyncDevice'
        ])
        && profile.keys().hasAll(['id', 'name', 'url', 'cookies', 'updatedAt'])
        && profile.id == profileId
        && profile.name is string && profile.name.size() > 0 && profile.name.size() <= 120
        && profile.url is string && profile.url.size() > 0 && profile.url.size() <= 4096
        && profile.cookies is list && profile.cookies.size() <= 5000
        && profile.updatedAt is number
        && (!profile.keys().hasAny(['proxy']) || (profile.proxy is string && profile.proxy.size() <= 4096))
        && (!profile.keys().hasAny(['userAgent']) || (profile.userAgent is string && profile.userAgent.size() <= 2048))
        && (!profile.keys().hasAny(['timezone']) || (profile.timezone is string && profile.timezone.size() <= 128))
        && (!profile.keys().hasAny(['fingerprint']) || profile.fingerprint == null || profile.fingerprint is map)
        && (!profile.keys().hasAny(['fingerprintHeaders']) || profile.fingerprintHeaders is map)
        && (!profile.keys().hasAny(['fingerprintUpdatedAt']) || profile.fingerprintUpdatedAt == null || profile.fingerprintUpdatedAt is number)
        && (!profile.keys().hasAny(['revision']) || (profile.revision is number && profile.revision >= 0))
        && (!profile.keys().hasAny(['updatedBy']) || (profile.updatedBy is string && profile.updatedBy.size() <= 64))
        && (!profile.keys().hasAny(['activeHolder']) || profile.activeHolder == null || profile.activeHolder is map)
        && (!profile.keys().hasAny(['lastSyncUser']) || (profile.lastSyncUser is string && profile.lastSyncUser.size() <= 64))
        && (!profile.keys().hasAny(['lastSyncDevice']) || (profile.lastSyncDevice is string && profile.lastSyncDevice.size() <= 160));
    }

    match /profiles/{profileId} {
      // A UI-side filter is not authorization. A worker may fetch only profiles explicitly
      // assigned in their own authorizedUsers record; only admins may enumerate or mutate profiles.
      allow get: if hasProfileAccess(profileId) && profileId.matches('^[a-zA-Z0-9_-]+$');
      allow list: if isAdmin();

      allow create, update: if isAdmin() && profileId.matches('^[a-zA-Z0-9_-]+$')
        && isValidProfile(profileId);

      allow delete: if isAdmin();
    }

    // Anyone who has the app's Firebase apiKey can call createUserWithEmailAndPassword
    // and obtain SOME request.auth.uid for free (that's how Firebase Auth works by design).
    // So membership here must never be client-writable, or self-registration would let
    // an outside attacker grant themselves admin. Provisioning is a deliberate manual step:
    // after a teammate's first app login creates their Firebase Auth account (email
    // "<username>@oasis-browser.local"), an admin adds { username, role } for their uid
    // here from the Firebase Console.
    match /authorizedUsers/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // Admins can authorize and revoke teammates' UIDs
      allow create, update, delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      // The app always writes the caller's own username (see SyncManager.logActivity),
      // so require it match their authorizedUsers record — otherwise any authorized
      // (non-admin) user could forge a permanent entry framing a teammate for an action
      // they never took, since admins treat this log as authoritative.
      allow create: if isAuthorized()
        && request.resource.data.action is string
        && request.resource.data.timestamp is number
        && request.resource.data.username is string
        && request.resource.data.username == get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.username;
      allow list, get: if isAdmin();
      allow update, delete: if false;
    }

    match /teamUsers/{username} {
      allow read: if request.auth != null && (
        username == get(/databases/$(database)/documents/authorizedUsers/$(request.auth.uid)).data.username
        || isAdmin()
      );
      allow write: if isAdmin();
    }
  }
}
